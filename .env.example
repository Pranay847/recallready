# Obtain a key from Nebius Token Factory. Never commit a real key.
NEBIUS_API_KEY=

# Optional overrides
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Hosted demo only. Local runs leave this false.
RECALLREADY_HOSTED=false
# PUBLIC_URL=https://your-demo.example.com
# Render supplies RENDER_EXTERNAL_URL automatically.
# DEMO_ACCESS_CODE=generate-a-random-code-of-at-least-16-characters
